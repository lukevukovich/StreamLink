<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <base href="/" />
    <link rel="stylesheet" href="app.css?v=23" />
    <link rel="stylesheet" href="streamlink-overrides.css" />
    <link rel="stylesheet" href="StreamLink.styles.css" />
    <meta name="theme-color" content="#07181b" />
    <link rel="icon" type="image/svg+xml" href="/streamlink-icon.svg?v=3" />
    <link rel="shortcut icon" type="image/svg+xml" href="/streamlink-icon.svg?v=3" />
    <link rel="mask-icon" href="/streamlink-icon.svg?v=3" color="#89c0b6" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <LinkPreview @rendermode="InteractiveServer" />
    <Routes @rendermode="InteractiveServer" />
    <div id="streamlink-reconnect" role="status" aria-live="polite">
        <div class="reconnect-card">
            <span class="loading-mark" aria-hidden="true"></span>
            <strong>Reconnecting to StreamLink</strong>
            <span id="streamlink-reconnect-message">Restoring your connection…</span>
            <button type="button" id="streamlink-reconnect-reload" class="button ghost">Reload now</button>
        </div>
    </div>
    <script src="js/external.js?v=13"></script>
    <script>
        window.streamlinkTime = {
            format: (utcValue) => {
                const date = new Date(utcValue);
                if (Number.isNaN(date.getTime())) return "";
                const options = { year: "numeric", month: "short", day: "numeric", hour: "numeric", minute: "2-digit", timeZoneName: "short" };
                return new Intl.DateTimeFormat(undefined, options).format(date);
            },
            formatElements: (selector) => {
                document.querySelectorAll(selector).forEach((element) => {
                    const local = window.streamlinkTime.format(element.dataset.utc);
                    if (local) element.textContent = local;
                });
            }
        };
    </script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="js/reconnect.js?v=1"></script>
</body>

</html>
