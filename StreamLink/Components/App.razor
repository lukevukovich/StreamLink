<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css?v=11" />
    <link rel="stylesheet" href="streamlink-overrides.css" />
    <link rel="stylesheet" href="StreamLink.styles.css" />
    <meta name="theme-color" content="#07181b" />
    <link rel="icon" type="image/svg+xml" href="/streamlink-icon.svg?v=3" />
    <link rel="shortcut icon" type="image/svg+xml" href="/streamlink-icon.svg?v=3" />
    <link rel="mask-icon" href="/streamlink-icon.svg?v=3" color="#89c0b6" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.20/dist/hls.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/mpegts.js@1.8.2/dist/mpegts.js"></script>
    <script src="js/player.js?v=11"></script>
    <script>
        window.streamlinkTime = {
            format: (utcValue) => {
                const date = new Date(utcValue);
                if (Number.isNaN(date.getTime())) return "";
                const options = { year: "numeric", month: "short", day: "numeric", hour: "numeric", minute: "2-digit", timeZoneName: "short" };
                return new Intl.DateTimeFormat(undefined, options).format(date);
            },
            formatElements: (selector) => {
                document.querySelectorAll(selector).forEach((element) => {
                    const local = window.streamlinkTime.format(element.dataset.utc);
                    if (local) element.textContent = local;
                });
            }
        };
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
