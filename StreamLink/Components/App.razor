<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <title>StreamLink</title>
    <base href="/" />
    <meta name="theme-color" content="#07181b" />
    <link rel="icon" type="image/svg+xml" href="/streamlink-icon.svg?v=3" />
    <link rel="shortcut icon" type="image/svg+xml" href="/streamlink-icon.svg?v=3" />
    <link rel="mask-icon" href="/streamlink-icon.svg?v=3" color="#89c0b6" />
    <script>
        window.streamlinkTheme = (() => {
            const supportedThemes = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(AppThemes.All.Select(theme => theme.Id)));
            const themeColors = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(AppThemes.All.ToDictionary(theme => theme.Id, theme => theme.MainColor)));
            const cacheKey = "streamlink.theme";
            const normalizeTheme = (theme) => theme === "jack-o-lantern" ? "halloween" : theme;
            let currentTheme = null;
            const updateThemeColor = () => {
                const themeColor = document.querySelector('meta[name="theme-color"]');
                const background = themeColors[document.documentElement.dataset.theme]
                    || getComputedStyle(document.documentElement).getPropertyValue("--bg").trim();
                if (themeColor && background) themeColor.content = background;
            };
            const apply = (theme) => {
                const normalizedTheme = normalizeTheme(theme);
                const selectedTheme = supportedThemes.includes(normalizedTheme) ? normalizedTheme : "green";
                currentTheme = selectedTheme;
                document.documentElement.dataset.theme = selectedTheme;
                updateThemeColor();
                return selectedTheme;
            };

            const readCachedTheme = () => {
                let theme = null;
                try {
                    theme = localStorage.getItem(cacheKey);
                } catch (error) {
                    console.warn("Could not read the saved theme preference.", error);
                }
                let normalizedTheme = normalizeTheme(theme);
                if (supportedThemes.includes(normalizedTheme)) {
                    if (normalizedTheme !== theme) {
                        try { localStorage.setItem(cacheKey, normalizedTheme); }
                        catch (error) { console.warn("Could not update the saved theme preference.", error); }
                    }
                    return normalizedTheme;
                }

                try {
                    theme = sessionStorage.getItem(cacheKey);
                    normalizedTheme = normalizeTheme(theme);
                    if (!supportedThemes.includes(normalizedTheme)) return null;
                    try { localStorage.setItem(cacheKey, normalizedTheme); }
                    catch (error) { console.warn("Could not migrate the cached theme preference.", error); }
                    return normalizedTheme;
                } catch (error) {
                    console.warn("Could not read the cached theme from this tab.", error);
                    return null;
                }
            };

            const restoreCachedTheme = () => {
                const theme = readCachedTheme() ?? currentTheme;
                return theme ? apply(theme) : null;
            };

            let cachedTheme = readCachedTheme();
            if (cachedTheme) {
                apply(cachedTheme);
            }

            window.addEventListener("pageshow", restoreCachedTheme);
            window.addEventListener("popstate", restoreCachedTheme);
            window.addEventListener("load", updateThemeColor);
            document.addEventListener("visibilitychange", () => {
                if (!document.hidden) restoreCachedTheme();
            });

            return {
                get: readCachedTheme,
                restore: restoreCachedTheme,
                ready: () => document.getElementById("streamlink-initial-loading")?.remove(),
                set: (theme) => {
                    const selectedTheme = apply(theme);
                    try {
                        localStorage.setItem(cacheKey, selectedTheme);
                    } catch (error) {
                        console.warn("Could not save the theme preference locally.", error);
                    }
                    try {
                        sessionStorage.setItem(cacheKey, selectedTheme);
                    } catch (error) {
                        console.warn("Could not save the theme preference for this tab.", error);
                    }
                }
            };
        })();
    </script>
    <link rel="stylesheet" href="app.css?v=70" />
    <link rel="stylesheet" href="streamlink-overrides.css?v=25" />
    <link rel="stylesheet" href="StreamLink.styles.css" />
    <HeadOutlet />
</head>

<body>
    <div class="page-background" aria-hidden="true"></div>
    <LinkPreview />
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <div class="auth-loading" id="streamlink-initial-loading" role="status"><span class="loading-mark" aria-hidden="true"></span><span>Loading <span class="wordmark"><span>Stream</span><span>Link</span></span>…</span></div>
    <div id="streamlink-reconnect" role="status" aria-live="polite">
        <div class="reconnect-card">
            <span class="loading-mark" aria-hidden="true"></span>
            <strong>Reconnecting to StreamLink</strong>
            <span id="streamlink-reconnect-message">Restoring your connection…</span>
            <button type="button" id="streamlink-reconnect-reload" class="button ghost">Reload now</button>
        </div>
    </div>
    <script src="js/catalog-search.js?v=2"></script>
    <script src="js/external.js?v=14"></script>
    <script>
        window.streamlinkTitle = {
            set: (title) => { document.title = title; }
        };
        window.streamlinkTime = {
            formatRemaining: (element) => {
                const expires = new Date(element.dataset.utc);
                if (Number.isNaN(expires.getTime())) return;
                const remainingMs = expires.getTime() - Date.now();
                if (remainingMs <= 0) {
                    element.textContent = "Expired";
                    return;
                }
                const minutes = Math.ceil(remainingMs / 60000);
                const suffix = element.classList.contains("share-time-remaining") ? "" : " remaining";
                if (minutes < 60) {
                    element.textContent = `${minutes}m${suffix}`;
                    return;
                }
                const hours = Math.floor(minutes / 60);
                const remainingMinutes = minutes % 60;
                if (hours < 24) {
                    element.textContent = remainingMinutes === 0
                        ? `${hours}h${suffix}`
                        : `${hours}h ${remainingMinutes}m${suffix}`;
                    return;
                }
                const days = Math.floor(minutes / 1440);
                const remainingHours = Math.floor((minutes % 1440) / 60);
                const minutesAfterHours = minutes % 60;
                const dayLabel = days === 1 ? "day" : "days";
                if (remainingHours === 0) {
                    element.textContent = minutesAfterHours === 0
                        ? `${days} ${dayLabel}${suffix}`
                        : `${days} ${dayLabel} ${minutesAfterHours}m${suffix}`;
                } else {
                    element.textContent = minutesAfterHours === 0
                        ? `${days} ${dayLabel} ${remainingHours}h${suffix}`
                        : `${days} ${dayLabel} ${remainingHours}h ${minutesAfterHours}m${suffix}`;
                }
            },
            format: (utcValue) => {
                const date = new Date(utcValue);
                if (Number.isNaN(date.getTime())) return "";
                const time = new Intl.DateTimeFormat(undefined, {
                    hour: "numeric", minute: "2-digit", timeZoneName: "short"
                }).format(date);
                const dateOptions = { month: "short", day: "numeric" };
                if (date.getFullYear() !== new Date().getFullYear()) dateOptions.year = "numeric";
                const formattedDate = new Intl.DateTimeFormat(undefined, dateOptions).format(date);
                return `${time}, ${formattedDate}`;
            },
            formatElements: (selector) => {
                document.querySelectorAll(selector).forEach((element) => {
                    if (element.classList.contains("time-remaining")) {
                        window.streamlinkTime.formatRemaining(element);
                    } else {
                        const local = window.streamlinkTime.format(element.dataset.utc);
                        if (local) element.textContent = local;
                    }
                });
                if (!window.streamlinkTime.remainingTimerStarted) {
                    window.streamlinkTime.remainingTimerStarted = true;
                    window.setInterval(() => {
                        document.querySelectorAll(".time-remaining").forEach(window.streamlinkTime.formatRemaining);
                    }, 30000);
                }
            }
        };
    </script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="js/reconnect.js?v=3"></script>
</body>

</html>
