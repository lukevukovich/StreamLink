@inherits LayoutComponentBase
@implements IDisposable
@inject SessionState Session
@inject SessionPersistence SessionPersistence
@inject ThemePreferenceService ThemePreferences
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject ILogger<MainLayout> Logger

<div class="app-shell @(IsAuthScreen ? "auth-shell" : "")">
    <header class="topbar">
        <a class="brand" href="@(Session.IsAuthenticated ? "/" : "/login")">Stream<span>Link</span></a>
        <div class="topbar-actions">
            <NavMenu IsAuthenticated="@Session.IsAuthenticated" />
        </div>
    </header>
    <main class="content-wrap @(IsLoginRoute ? "auth-content" : "")">
        @if (!Session.IsHydrated)
        {
            <div class="auth-loading" role="status"><span class="loading-mark" aria-hidden="true"></span><span>Loading <span class="wordmark"><span>Stream</span><span>Link</span></span>…</span></div>
        }
        else
        {
            @Body
        }
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var cachedTheme = AppThemes.Default;
        string? themeToApply = null;
        try
        {
            var browserTheme = await Js.InvokeAsync<string?>("streamlinkTheme.get");
            if (browserTheme is not null && AppThemes.IsSupported(browserTheme))
            {
                cachedTheme = browserTheme;
                themeToApply = cachedTheme;
            }
            Session.SetTheme(cachedTheme);

            var protectedSession = await Js.InvokeAsync<string?>("streamlinkStorage.get", SessionPersistence.StorageKeyName);
            var restored = SessionPersistence.Unprotect(protectedSession);
            if (restored is not null)
            {
                Session.SetSession(restored);
                themeToApply = await ThemePreferences.GetSavedThemeAsync(Session.OwnerKey) ?? cachedTheme;
                Session.SetTheme(themeToApply);
            }
            else if (themeToApply is null)
            {
                themeToApply = cachedTheme;
            }
        }
        catch (Microsoft.Data.Sqlite.SqliteException ex)
        {
            Logger.LogError(ex, "Could not load the account theme preference.");
            Session.SetTheme(cachedTheme);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Could not restore the browser theme preference.");
        }
        finally
        {
            if (themeToApply is not null)
            {
                try { await Js.InvokeVoidAsync("streamlinkTheme.set", themeToApply); }
                catch (JSException ex) { Logger.LogWarning(ex, "Could not apply the saved theme in the browser."); }
            }
            Session.MarkHydrated();
            try { await Js.InvokeVoidAsync("streamlinkTheme.ready"); }
            catch (JSException ex) { Logger.LogWarning(ex, "Could not dismiss the initial loading screen."); }
            if (Navigation.ToBaseRelativePath(Navigation.Uri).Equals("login", StringComparison.OrdinalIgnoreCase) && Session.IsAuthenticated)
                Navigation.NavigateTo("/", replace: true);
        }
    }

    private bool IsLoginRoute => Navigation.ToBaseRelativePath(Navigation.Uri).Equals("login", StringComparison.OrdinalIgnoreCase);
    private bool IsAuthScreen => !Session.IsAuthenticated && (string.IsNullOrEmpty(Navigation.ToBaseRelativePath(Navigation.Uri)) || IsLoginRoute);
}
