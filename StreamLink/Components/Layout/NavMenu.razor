@inject SessionState Session
@implements IDisposable
@if (Session.IsAuthenticated)
{
    <NavLink class="nav-pill nav-live" href="/tv" Match="NavLinkMatch.Prefix"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5.5h16v13H4z"/><path d="M8 2.5v3M16 2.5v3M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M16 14h.01"/></svg></span><span class="nav-label">Live TV</span></NavLink>
    <NavLink class="nav-pill nav-shares" href="/shares" Match="NavLinkMatch.All"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 12h8M13 7l5 5-5 5"/><path d="M18 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12"/></svg></span><span class="nav-label">Shares</span></NavLink>
    <NavLink class="profile-pill" href="/account" Match="NavLinkMatch.All" aria-label="Open account"><span class="profile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.2"/><path d="M5.5 20c.8-3.4 3-5.1 6.5-5.1s5.7 1.7 6.5 5.1"/></svg></span></NavLink>
}

@code {
    protected override void OnInitialized() => Session.Changed += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Session.Changed -= Refresh;
}

