@page "/tv/{CategoryId}"
@rendermode InteractiveServer
@inject IXtreamApiService Xtream
@inject SessionState Session
@inject NavigationManager Navigation

<DocumentTitle Title="@($"{CategoryName} · StreamLink")" />
@if (Session.Session is null) { <RedirectToLogin /> }
else
{
    <a class="back-link" href="/tv">← All categories</a><div class="page-heading compact"><div><div class="eyebrow">LIVE TELEVISION</div><h1>@CategoryName</h1><p class="muted page-intro">Pick a channel to open its stream.</p><span class="count-badge live-count"><span class="live-dot">LIVE</span> · @filteredChannels.Count() channels</span></div></div>
    <input class="search" placeholder="Search channels" @bind="Search" @bind:event="oninput" @bind:after="UpdateSearchUri" />
    @if (loading) { <div class="loading-card">Loading channels…</div> }
    else if (loadError is not null) { <div class="empty-card">@loadError</div> }
    else if (channels.Count == 0) { <div class="empty-card">No channels were returned for this category.</div> }
    else if (!filteredChannels.Any()) { <div class="empty-card">No channels match “@Search”.</div> }
    else
    {
        <div class="channel-list">
            @foreach (var channel in filteredChannels)
            {
                <button class="channel-row" @onclick="() => OpenChannel(channel)"><span class="channel-logo">@if (!string.IsNullOrWhiteSpace(channel.LogoUrl)) { <img src="@channel.LogoUrl" alt="" /> } else { <span>TV</span> }</span><span class="channel-copy"><strong>@channel.Name</strong><small>Live channel</small></span><span class="chevron">›</span></button>
            }
        </div>
    }
}

@code {
    [Parameter] public string CategoryId { get; set; } = "";
    private string CategoryName = "Live TV";
    private string? loadedCategoryId;
    private IReadOnlyList<XtreamChannel> channels = []; private bool loading = true; private string? loadError;
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; } = "";
    private IEnumerable<XtreamChannel> filteredChannels => CatalogSort.Apply(channels, channel => channel.Name, Search, "provider");
    private void UpdateSearchUri() => Navigation.NavigateTo(
        Navigation.GetUriWithQueryParameter("search", string.IsNullOrWhiteSpace(Search) ? null : Search),
        replace: true);
    private void OpenChannel(XtreamChannel channel) => Navigation.NavigateTo($"/channel/{channel.StreamId}");
    protected override async Task OnParametersSetAsync()
    {
        var categoryId = CategoryId;
        if (loadedCategoryId == categoryId) return;
        loadedCategoryId = categoryId;
        CategoryName = "Live TV";
        channels = [];
        loading = true;
        loadError = null;
        try
        {
            if (Session.Session is not null)
            {
                var categories = await Xtream.GetCategoriesAsync(Session.Session);
                var results = await Xtream.GetChannelsAsync(Session.Session, categoryId);
                if (CategoryId != categoryId) return;
                CategoryName = categories.FirstOrDefault(category => category.Id == categoryId)?.Name ?? "Live TV";
                channels = results;
            }
        }
        catch (ProviderAccessException ex) { if (CategoryId == categoryId) loadError = ex.Message; }
        catch (Exception) { if (CategoryId == categoryId) loadError = "Couldn't load channels. Try refreshing the page."; }
        finally { if (CategoryId == categoryId) loading = false; }
    }
}