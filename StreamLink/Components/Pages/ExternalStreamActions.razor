<section class="external-stream-card">
    <button type="button" class="external-stream-play" data-stream-action="open" data-stream-grant="@Grant" aria-label="Open stream" title="Open stream">
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M8 5.5a1 1 0 0 1 1.52-.85l9.5 6.5a1 1 0 0 1 0 1.7l-9.5 6.5A1 1 0 0 1 8 18.5z" fill="currentColor" /></svg>
    </button>
    <span class="external-stream-play-label">Open stream</span>
    <div class="external-stream-actions">
        <button type="button" class="button ghost" data-stream-action="vlc" data-stream-grant="@Grant" data-stream-name="@ChannelName"><span class="vlc-label-mobile">Play in VLC</span><span class="vlc-label-desktop">Download for VLC</span></button>
        <button type="button" class="button ghost" data-stream-action="copy" data-stream-grant="@Grant">Copy link</button>
    </div>
    <p class="external-stream-message" role="status" hidden></p>
    <input class="external-stream-select" type="text" aria-label="Resolved stream URL; tap and hold to copy" readonly hidden />
</section>

@code {
    [Parameter, EditorRequired] public string Grant { get; set; } = "";
    [Parameter, EditorRequired] public string ChannelName { get; set; } = "";
}