@page "/"
@page "/login"
@rendermode InteractiveServer
@inject IXtreamApiService Xtream
@inject SessionState Session
@inject SessionPersistence SessionPersistence
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>@(Session.IsAuthenticated ? "Welcome · streamlink" : "Sign in · streamlink")</PageTitle>
@if (Session.IsAuthenticated)
{
<div class="welcome-page"><div class="eyebrow"><span class="wordmark"><span>stream</span><span>link</span></span></div><h1>Ready when you are.</h1><p class="muted">Your live TV library is waiting. Browse categories, reopen a shared stream, or manage your account.</p><div class="welcome-grid">
	<a class="welcome-card" href="/tv"><span class="welcome-card-icon"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="13" rx="2.5"/><path d="m10 9 5 2.5-5 2.5zM8 22h8M12 18v4"/></svg></span><strong>Live TV</strong><span>Browse live categories and find a channel to watch.</span><span class="welcome-card-link">Explore TV <b>→</b></span></a>
	<a class="welcome-card" href="/shares"><span class="welcome-card-icon"><svg viewBox="0 0 24 24"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5"/></svg></span><strong>Shares</strong><span>Create, copy, and manage your shared stream links.</span><span class="welcome-card-link">Manage shares <b>→</b></span></a>
	<a class="welcome-card" href="/watch"><span class="welcome-card-icon"><svg viewBox="0 0 24 24"><path d="M10 14a5 5 0 0 0 7.1 0l3-3a5 5 0 0 0-7.1-7.1l-1.7 1.7"/><path d="M14 10a5 5 0 0 0-7.1 0l-3 3A5 5 0 0 0 11 20.1l1.7-1.7"/></svg></span><strong>Watch a stream</strong><span>Paste a family or friend’s streamlink URL or share code.</span><span class="welcome-card-link">Open a link <b>→</b></span></a>
	<a class="welcome-card" href="/account"><span class="welcome-card-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.2"/><path d="M5.5 20c.8-3.4 3-5.1 6.5-5.1s5.7 1.7 6.5 5.1"/></svg></span><strong>Profile</strong><span>View account status and connection information.</span><span class="welcome-card-link">View profile <b>→</b></span></a>
</div></div>
}
else
{
<div class="login-page compact-login">
	<div class="login-orbit"></div>
	<section class="login-card">
		<div class="eyebrow">YOUR TV, SIMPLIFIED</div>
		<h1>Welcome to <span class="wordmark"><span>stream</span><span>link</span></span></h1>
		<p class="muted">Connect your Xtream account to browse and watch live television anywhere.</p>
		<div class="login-form" @onkeydown="HandleKeyDown">
			<label>Server URL<input @bind="credentials.ServerUrl" @bind:event="oninput" placeholder="https://provider.example" inputmode="url" /></label>
			<label>Username<input @bind="credentials.Username" @bind:event="oninput" autocomplete="username" /></label>
			<label>Password<input @bind="credentials.Password" @bind:event="oninput" type="password" autocomplete="current-password" /></label>
			@if (!string.IsNullOrWhiteSpace(error)) { <div class="alert">@error</div> }
			<button type="button" class="button primary wide" disabled="@busy" @onclick="ConnectAsync">@(busy ? "Connecting…" : "Connect securely")</button>
		</div>
		<div class="login-note"><span>●</span> Encrypted on this device · never logged</div>
	</section>
</div>
}

@code {
	private Credentials credentials = new();
	private bool busy;
	private string? error;
	private async Task ConnectAsync()
	{
		if (busy) return;
		error = null;
		if (!Uri.TryCreate(credentials.ServerUrl.Trim(), UriKind.Absolute, out var server) || server.Scheme is not ("http" or "https"))
		{
			error = "Enter a complete server address, including https://.";
			return;
		}
		if (string.IsNullOrWhiteSpace(credentials.Username) || string.IsNullOrWhiteSpace(credentials.Password))
		{
			error = "Enter your username and password to continue.";
			return;
		}

		busy = true;
		try
		{
			var session = await Xtream.LoginAsync(server.ToString(), credentials.Username.Trim(), credentials.Password);
			if (session is null) error = "We couldn't connect. Check your details and provider address, then try again.";
			else
			{
				Session.SetSession(session);
				await Js.InvokeVoidAsync("streamlinkStorage.set", SessionPersistence.StorageKeyName, SessionPersistence.Protect(session));
				Navigation.NavigateTo("/", replace: true);
			}
		}
		catch (JSException) { error = "The browser could not save this session. Please allow site storage and try again."; }
		catch (Exception) { error = "The provider responded, but streamlink could not complete the sign-in. Please try again."; }
		finally { busy = false; }
	}

	private async Task HandleKeyDown(KeyboardEventArgs args)
	{
		if (args.Key == "Enter") await ConnectAsync();
	}

	private sealed class Credentials
	{
		public string ServerUrl { get; set; } = "";
		public string Username { get; set; } = "";
		public string Password { get; set; } = "";
	}
}
