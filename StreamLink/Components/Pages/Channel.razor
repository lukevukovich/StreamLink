@page "/channel/{StreamId:int}"
@rendermode InteractiveServer
@inject SessionState Session
@inject IXtreamApiService Xtream
@inject IStreamUrlService Urls
@inject IShareLinkService Shares
@inject ExternalLinkService ExternalLinks
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>@ChannelName · StreamLink</PageTitle>
@if (Session.Session is null) { <RedirectToLogin /> }
else if (loading) { <div class="loading-card">Loading channel…</div> }
else if (!channelFound) { <div class="empty-card">@(loadFailed ? "Couldn't load this channel. Try refreshing the page." : "This channel is not available in your account.")</div> }
else
{
    <a class="back-link" href="/tv">← Live TV</a>
    <section class="detail-hero"><div><div class="eyebrow">NOW AVAILABLE</div><h1>@ChannelName</h1><p class="muted detail-subtitle"><span class="live-dot">LIVE</span><span>@CategoryName · Stream @StreamId</span></p></div></section>
    @if (links is not null && (links.HlsAllowed || links.TsAllowed))
    {
        <ExternalStreamActions Grant="@externalGrant" ChannelName="@ChannelName" />
    }
    else { <div class="unavailable-card">This provider does not allow a supported stream format for this channel.</div> }
    <section class="panel share-panel" aria-label="Share this channel">
        <div class="section-title">
            <div><div class="eyebrow">SHARE</div><h2>Share this channel</h2></div>
            @if (shareUrl is null)
            {
                <button type="button" class="button ghost" disabled="@(shareBusy || links is null || (!links.HlsAllowed && !links.TsAllowed))" aria-expanded="@showShareForm" aria-controls="share-settings" @onclick="ToggleShareForm">@(showShareForm ? "Hide settings" : "Share")</button>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(shareUrl))
        {
            <div class="share-created" role="status" aria-live="polite">
                <strong>Share link ready</strong>
                <span class="copy-status" role="status" hidden></span>
                <input type="text" readonly value="@shareUrl" aria-label="Share link" onclick="this.select()" />
                <div class="share-created-actions"><button type="button" class="button small ghost" data-copy-input>Copy link</button><a class="button small ghost" href="@shareUrl">Open link →</a></div>
                <small>Expires <time class="local-time" data-utc="@shareExpiresUtc.ToString("O")">@shareExpiresUtc.ToString("MMM d, yyyy 'at' h:mm tt 'UTC'")</time>@(reusedShare ? " · Existing share reused" : "")</small>
            </div>
        }
        else if (showShareForm)
        {
            <div id="share-settings" class="share-form">
                <label for="share-hours">Link lifetime</label>
                <div class="share-form-controls">
                    <select id="share-hours" class="search" @bind="shareHours" disabled="@shareBusy">
                        <option value="1">1 hour</option><option value="2">2 hours</option><option value="4">4 hours</option>
                        <option value="8">8 hours</option><option value="12">12 hours</option><option value="24">24 hours</option>
                    </select>
                    <button type="button" class="button primary" disabled="@shareBusy" @onclick="CreateShare">@(shareBusy ? "Creating…" : "Share")</button>
                    <button type="button" class="button ghost" disabled="@shareBusy" @onclick="CancelShare">Cancel</button>
                </div>
                <p class="muted share-form-note">An existing active link for this channel keeps its original expiry.</p>
                @if (!string.IsNullOrWhiteSpace(shareError)) { <div class="alert" role="alert">@shareError</div> }
            </div>
        }
    </section>
    <section class="panel"><div class="section-title"><div><div class="eyebrow">STREAM LINKS</div><h2>Choose a format</h2></div></div>
        @if (links is not null) { @if (links.HlsAllowed) { <LinkRow Label="HLS · .m3u8" Url="@links.HlsUrl" /> } @if (links.TsAllowed) { <LinkRow Label="MPEG-TS · .ts" Url="@links.TsUrl" /> } }
    </section>
}

@code {
    [Parameter] public int StreamId { get; set; }
    private string ChannelName = "Channel";
    private string CategoryName = "Live TV";
    private bool channelFound;
    private bool loading = true;
    private bool loadFailed;
    private StreamLinks? links; private string? shareUrl; private string? shareError; private bool shareBusy; private bool showShareForm; private bool reusedShare; private int shareHours = 4; private DateTime shareExpiresUtc; private string externalGrant = ""; private int? loadedStreamId;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Navigation.ToAbsoluteUri(Navigation.Uri).Query.Length > 0)
        {
            Navigation.NavigateTo($"/channel/{StreamId}", replace: true);
            return;
        }
        if (shareUrl is not null) await Js.InvokeVoidAsync("streamlinkTime.formatElements", ".share-created .local-time");
    }
    protected override async Task OnParametersSetAsync()
    {
        if (Session.Session is null) { links = null; loadedStreamId = null; return; }
        if (loadedStreamId == StreamId) return;
        loadedStreamId = StreamId;
        var streamId = StreamId;
        var session = Session.Session;
        loading = true;
        channelFound = false;
        loadFailed = false;
        links = null;
        ChannelName = "Channel";
        CategoryName = "Live TV";
        shareUrl = null;
        shareError = null;
        showShareForm = false;
        shareHours = 4;
        try
        {
            var channels = await Xtream.GetChannelsAsync(session, "");
            var channel = channels.FirstOrDefault(item => item.StreamId == streamId);
            IReadOnlyList<XtreamCategory>? categories = null;
            if (channel is null || !string.IsNullOrWhiteSpace(channel.CategoryId))
                categories = await Xtream.GetCategoriesAsync(session);
            if (channel is null && categories is not null)
            {
                foreach (var category in categories)
                {
                    if (StreamId != streamId) return;
                    channel = (await Xtream.GetChannelsAsync(session, category.Id)).FirstOrDefault(item => item.StreamId == streamId);
                    if (channel is null) continue;
                    CategoryName = category.Name;
                    break;
                }
            }
            if (StreamId != streamId) return;
            if (channel is not null)
            {
                ChannelName = channel.Name;
                if (!string.IsNullOrWhiteSpace(channel.CategoryId))
                    CategoryName = categories?.FirstOrDefault(item => item.Id == channel.CategoryId)?.Name ?? CategoryName;
                channelFound = true;
                links = Urls.BuildLinks(session, streamId);
                externalGrant = ExternalLinks.CreateChannelGrant(links.HlsAllowed ? links.HlsUrl : links.TsUrl);
            }
        }
        catch (Exception) { if (StreamId == streamId) { loadFailed = true; channelFound = false; links = null; } }
        finally { if (StreamId == streamId) loading = false; }
    }
    private void ToggleShareForm() { if (!shareBusy && shareUrl is null) { shareError = null; showShareForm = !showShareForm; } }
    private void CancelShare() { if (!shareBusy) { shareError = null; showShareForm = false; } }
    private async Task CreateShare()
    {
        if (shareBusy || !showShareForm || shareUrl is not null || Session.Session is null || links is null || (!links.HlsAllowed && !links.TsAllowed)) return;
        shareBusy = true;
        shareError = null;
        var streamId = StreamId;
        var requestedAt = DateTime.UtcNow;
        try
        {
            var link = await Shares.CreateAsync(Session.Session, Session.OwnerKey,
                new XtreamChannel { StreamId = streamId, Name = ChannelName }, CategoryName, shareHours);
            if (StreamId == streamId)
            {
                shareUrl = Navigation.ToAbsoluteUri($"/watch/{link.Token}").ToString();
                shareExpiresUtc = DateTime.SpecifyKind(link.ExpiresUtc, DateTimeKind.Utc);
                reusedShare = link.CreatedUtc < requestedAt.AddSeconds(-2);
                showShareForm = false;
            }
        }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentOutOfRangeException) { shareError = exception.Message; }
        catch (Exception) { shareError = "Couldn't create a share link. Please try again."; }
        finally { shareBusy = false; }
    }
}